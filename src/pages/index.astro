---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="container">
          <span class="eyebrow">Vegan family travel, field-tested</span>
          <h1>Small human.<br /><em>Big appetite</em> for the world.</h1>
          <p class="lede">
            Honest guides to traveling with a vegan toddler — where to eat,
            what to pack, which cities make it easy, and where to find a
            proper flat white with a stroller in tow.
          </p>
          <div class="cta">
            <a class="btn" href="/blog/">Read the guides</a>
            <a class="ghost" href="/about/">Who are we? →</a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <span class="eyebrow">Latest guides</span>
          <div class="grid">
            {
              posts.map((post) => (
                <div class="card">
                  <a href={`/blog/${post.id}/`}>
                    {post.data.heroImage && (
                      <img
                        src={post.data.heroImage}
                        alt=""
                        width="400"
                        height="210"
                        loading="lazy"
                      />
                    )}
                    <div class="card-body">
                      <div class="card-meta">
                        {post.data.destination && (
                          <strong>{post.data.destination} · </strong>
                        )}
                        <FormattedDate date={post.data.pubDate} />
                      </div>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.description}</p>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>
    <Newsletter />
    <Footer />
  </body>
</html>

<style>
  .hero {
    padding: 5.5rem 0 4.5rem;
    border-bottom: 1px solid var(--line);
  }
  .hero em { color: var(--clay); }
  .lede {
    max-width: 540px;
    font-size: 1.12rem;
    color: var(--ink-soft);
    margin-top: 1.25rem;
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .ghost {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .card img {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 3 / 2;
  }
</style>
