---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="container">
          <span class="eyebrow">Vegan family travel, field-tested</span>
          <h1>Small human.<br />Big appetite for the world.</h1>
          <p class="lede">
            Honest guides to traveling with a vegan toddler — where to eat,
            what to pack, which cities make it easy, and where to find a
            proper flat white with a stroller in tow.
          </p>
          <div class="cta">
            <a class="btn" href="/blog/">Read the guides</a>
            <a class="ghost" href="/about/">Who are we? →</a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <h2>Latest guides</h2>
          <div class="grid">
            {
              posts.map((post) => (
                <div class="card">
                  <a href={`/blog/${post.id}/`}>
                    {post.data.heroImage && (
                      <img
                        src={post.data.heroImage}
                        alt=""
                        width="400"
                        height="210"
                        loading="lazy"
                      />
                    )}
                    <div class="card-body">
                      <div class="card-meta">
                        {post.data.destination && (
                          <strong>{post.data.destination} · </strong>
                        )}
                        <FormattedDate date={post.data.pubDate} />
                      </div>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.description}</p>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>
    <Newsletter />
    <Footer />
  </body>
</html>

<style>
  .hero {
    padding: 4.5rem 0 3.5rem;
    background:
      radial-gradient(600px 300px at 85% 20%, rgba(185, 170, 222, 0.28), transparent),
      radial-gradient(500px 260px at 10% 85%, rgba(215, 236, 223, 0.9), transparent),
      radial-gradient(400px 220px at 60% 100%, rgba(232, 164, 164, 0.18), transparent);
  }
  .lede {
    max-width: 560px;
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin-top: 1rem;
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .ghost {
    font-weight: 600;
    text-decoration: none;
  }
  .card img {
    border-radius: 0;
    width: 100%;
    object-fit: cover;
    aspect-ratio: 40 / 21;
  }
</style>
