---
import { SITE_TITLE } from '../consts';
---

<header>
  <nav class="container">
    <a class="wordmark" href="/">
      <span class="mark">🌱✈️</span>
      {SITE_TITLE}
    </a>
    <div class="links">
      <a href="/blog/">Guides</a>
      <a href="/about/">About</a>
      <a class="btn small" href="/#newsletter">Get the packing list</a>
    </div>
  </nav>
</header>

<style>
  header {
    background: var(--paper);
    border-bottom: 1.5px dashed var(--rose);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .mark { margin-right: 0.3rem; }
  .links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .links a {
    text-decoration: none;
    font-weight: 600;
    color: var(--ink);
  }
  .links a:hover { color: var(--rose-deep); }
  .links a.btn.small { padding: 0.45rem 1rem; font-size: 0.9rem; color: var(--paper); }
  .links a.btn.small:hover { color: var(--paper); }
  @media (max-width: 640px) {
    .btn.small { display: none; }
  }
</style>
