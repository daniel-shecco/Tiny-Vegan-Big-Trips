---
/*
  Newsletter signup, wired to Kit (form 9744194).
  Posts directly to Kit's endpoint; JS enhances with an inline success
  state, and falls back to a normal POST (Kit-hosted confirmation page)
  if fetch fails.
*/
const KIT_FORM_ACTION = 'https://app.kit.com/forms/9744194/subscriptions';
---

<section id="newsletter" class="signup">
  <div class="container inner">
    <div>
      <span class="eyebrow">The newsletter</span>
      <h2>The Vegan Kid Flight Survival Kit</h2>
      <p>
        The exact snack list, gear list, and boarding-day routine we use on
        every flight. Join the list and it's yours.
      </p>
    </div>
    <form action={KIT_FORM_ACTION} method="post" data-newsletter>
      <input
        type="email"
        name="email_address"
        placeholder="you@example.com"
        required
        aria-label="Email address"
      />
      <button class="btn" type="submit">Subscribe</button>
      <p class="form-note" data-note hidden></p>
    </form>
  </div>
</section>

<script is:inline>
  const form = document.querySelector('form[data-newsletter]');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const note = form.querySelector('[data-note]');
      const button = form.querySelector('button');
      button.disabled = true;
      button.textContent = 'Subscribing…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error('subscribe failed');
        form.querySelector('input').hidden = true;
        button.hidden = true;
        note.textContent =
          'Done — now check your inbox and confirm your subscription. ' +
          'No email after a minute or two? Check your spam folder — ' +
          'first-time emails sometimes hide there.';
        note.hidden = false;
      } catch {
        // Fall back to a regular POST (Kit's hosted confirmation page)
        form.removeEventListener('submit', () => {});
        form.submit();
      }
    });
  }
</script>

<style>
  .signup {
    background: var(--tint);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 3.5rem 0;
  }
  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .signup p { color: var(--ink-soft); margin: 0; }
  form { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  input {
    flex: 1;
    min-width: 200px;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper);
    font-size: 0.95rem;
    font-family: var(--font-label);
  }
  input:focus { outline: 1px solid var(--clay); border-color: var(--clay); }
  .form-note {
    width: 100%;
    font-family: var(--font-label);
    font-size: 0.9rem;
    color: var(--ink) !important;
  }
  @media (max-width: 720px) {
    .inner { grid-template-columns: 1fr; }
  }
</style>
