---
/*
  Placeholder newsletter signup. Point the form action at your email
  provider (Kit, Buttondown, MailerLite…) once you have an account.
*/
---

<section id="newsletter" class="signup">
  <div class="container inner">
    <div>
      <span class="eyebrow">Free download</span>
      <h2>The Vegan Toddler Flight Survival Kit</h2>
      <p>
        The exact snack list, gear list, and boarding-day routine we use on
        every long-haul flight. Join the list and it's yours.
      </p>
    </div>
    <form action="#" method="post" onsubmit="alert('Hook me up to a real email provider!'); return false;">
      <input type="email" name="email" placeholder="you@example.com" required aria-label="Email address" />
      <button class="btn" type="submit">Send me the kit</button>
    </form>
  </div>
</section>

<style>
  .signup {
    background: linear-gradient(120deg, var(--butter), var(--mint));
    border-top: 1.5px dashed var(--rose);
    border-bottom: 1.5px dashed var(--rose);
    padding: 3rem 0;
  }
  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .signup p { color: var(--ink-soft); margin: 0; }
  form { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  input {
    flex: 1;
    min-width: 200px;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 1rem;
    font-family: inherit;
  }
  input:focus { outline: 2px solid var(--lilac); border-color: var(--lilac); }
  @media (max-width: 720px) {
    .inner { grid-template-columns: 1fr; }
  }
</style>
