---
/*
  Placeholder newsletter signup. Point the form action at your email
  provider (Kit, Buttondown, MailerLite…) once you have an account.
*/
---

<section id="newsletter" class="signup">
  <div class="container inner">
    <div>
      <span class="eyebrow">The newsletter</span>
      <h2>The Vegan Kid Flight Survival Kit</h2>
      <p>
        The exact snack list, gear list, and boarding-day routine we use on
        every flight. Join the list and it's yours.
      </p>
    </div>
    <form action="#" method="post" onsubmit="alert('Hook me up to a real email provider!'); return false;">
      <input type="email" name="email" placeholder="you@example.com" required aria-label="Email address" />
      <button class="btn" type="submit">Subscribe</button>
    </form>
  </div>
</section>

<style>
  .signup {
    background: var(--tint);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 3.5rem 0;
  }
  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .signup p { color: var(--ink-soft); margin: 0; }
  form { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  input {
    flex: 1;
    min-width: 200px;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper);
    font-size: 0.95rem;
    font-family: var(--font-label);
  }
  input:focus { outline: 1px solid var(--clay); border-color: var(--clay); }
  @media (max-width: 720px) {
    .inner { grid-template-columns: 1fr; }
  }
</style>
