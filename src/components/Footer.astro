---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
  <div class="container inner">
    <div>
      <strong>{SITE_TITLE}</strong>
      <p>Good food, good coffee, small human.</p>
    </div>
    <div class="social">
      <!-- Swap # for your real handles once claimed -->
      <a href="#" aria-label="Instagram">Instagram</a>
      <a href="#" aria-label="Pinterest">Pinterest</a>
      <a href="#" aria-label="TikTok">TikTok</a>
      <a href="/rss.xml" aria-label="RSS feed">RSS</a>
    </div>
  </div>
  <div class="container legal">
    &copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
  </div>
</footer>

<style>
  footer {
    margin-top: 5rem;
    background: var(--tint);
    border-top: 1px solid var(--line);
    color: var(--ink);
    padding: 3rem 0 1.75rem;
  }
  footer strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
  }
  footer p {
    color: var(--ink-soft);
    font-style: italic;
    margin: 0.35rem 0 0;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .social { display: flex; gap: 1.75rem; }
  .social a {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .social a:hover { color: var(--clay); }
  .legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }
</style>
