---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
  <div class="container inner">
    <div>
      <strong>{SITE_TITLE}</strong>
      <p>Good food, good coffee, small human.</p>
    </div>
    <div class="social">
      <!-- Swap # for your real handles once claimed -->
      <a href="#" aria-label="Instagram">Instagram</a>
      <a href="#" aria-label="Pinterest">Pinterest</a>
      <a href="#" aria-label="TikTok">TikTok</a>
      <a href="/rss.xml" aria-label="RSS feed">RSS</a>
    </div>
  </div>
  <div class="container legal">
    &copy; {today.getFullYear()} {SITE_TITLE}. Made with oat milk. All rights reserved.
  </div>
</footer>

<style>
  footer {
    margin-top: 4rem;
    background: var(--lilac-soft);
    border-top: 1.5px dashed var(--lilac);
    color: var(--ink);
    padding: 2.5rem 0 1.5rem;
  }
  footer strong { font-family: var(--font-display); font-size: 1.15rem; }
  footer p { color: var(--ink-soft); margin: 0.3rem 0 0; }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .social { display: flex; gap: 1.25rem; }
  .social a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .social a:hover { color: var(--rose-deep); }
  .legal {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(64, 57, 74, 0.12);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
</style>
